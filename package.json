{
  "name": "@rekundzmitry/omp-extensions",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@oh-my-pi/pi-coding-agent": "^18.0.11",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "biome check packages/*/src",
    "test": "bun test packages/*",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules .tsbuildinfo packages/*/.tsbuildinfo"
  }
}