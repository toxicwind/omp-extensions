{
  "name": "@rekundzmitry/omp-extensions",
  "version": "0.1.0",
  "description": "Monorepo of oh-my-pi (omp) extensions by RekunDzmitry.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "biome check packages/*/src",
    "test": "bun test packages/*",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules .tsbuildinfo packages/*/.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@oh-my-pi/pi-coding-agent": "^17.0.2",
    "typescript": "^5.6.0"
  }
}
